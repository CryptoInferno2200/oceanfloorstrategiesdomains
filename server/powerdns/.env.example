# Copy to .env on the server. Never commit the real file.
PDNS_API_KEY=generate-with-openssl-rand-hex-32
API_HOST=dns-api.ofsdomains.com
# Web edge for customer names (ns1 only). OFS_EDGE_KEY must match the site's OFS_EDGE_KEY variable.
OFS_SITE=https://www.ofsdomains.com
OFS_EDGE_KEY=generate-with-openssl-rand-hex-32
